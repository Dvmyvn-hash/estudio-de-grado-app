# ==============================================================================
# CONFIGURACIÓN DE CORREO - GRADOMANÍA (v6.2)
# ==============================================================================
# Copia este archivo como .env (el cual está estrictamente protegido por .gitignore)
#
# ------------------------------------------------------------------------------
# OPCIÓN A: RESEND API (HTTPS / Recomendado para Producción en Render Free)
# ------------------------------------------------------------------------------
# Resend opera vía HTTPS (puerto 443) y NO sufre bloqueos de puertos SMTP en Render.
# Obtén tu API Key gratuita en: https://resend.com
#
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_tu_api_key_aqui
# Remitente autorizado en Resend (ej: 'GRADOMANÍA <onboarding@resend.dev>' o tu dominio verificado)
EMAIL_FROM=GRADOMANÍA <onboarding@resend.dev>

# ------------------------------------------------------------------------------
# OPCIÓN B: GMAIL SMTP (STARTTLS 587 / Para Desarrollo Local)
# ------------------------------------------------------------------------------
# Descomenta y configura si prefieres despachar vía Gmail en entorno local:
#
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=gradomaniacos@gmail.com
# SMTP_PASS=tu_app_password_de_16_caracteres
# EMAIL_FROM=GRADOMANÍA <gradomaniacos@gmail.com>
