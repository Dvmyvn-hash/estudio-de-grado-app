# ==========================================
# CONFIGURACIÓN SMTP - GRADOMANÍA (v6.1)
# ==========================================
# Para pruebas locales o producción:
# 1. Copia este archivo como .env (el cual está protegido por .gitignore)
# 2. Configura tu correo Gmail y tu Contraseña de Aplicación de 16 caracteres de Google
# (Seguridad -> Verificación en 2 pasos -> Contraseñas de aplicaciones -> Generar para "Correo")

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
